# Crew — environment (copy to .env.local; never commit real values). SPEC: Part IV third-party inventory.
# Every variable below is read in exactly one lib file (named in the comment). Missing = that feature is off
# in dev and the lib logs a one-line notice; the test suite never needs any of them (local substitutes).

# --- MongoDB Atlas (lib/db.ts) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=crew

# --- Auth (lib/auth.ts) — jose HS256 secret for access + refresh JWTs; ≥ 32 random bytes, base64 ---
JWT_SECRET=change-me-to-32-random-bytes-base64
# Sign in with Apple (lib/auth.ts): the iOS bundle id and the web Services ID are both accepted audiences
APPLE_BUNDLE_ID=com.yourteam.crew
APPLE_SERVICES_ID=com.yourteam.crew.web
# Set to a local JWKS URL in dev to test Apple verification without Apple (see tests/api/auth-apple.test.ts)
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# --- Vercel Blob (lib/blob.ts) — photos; leave empty locally to store under web/.blob-dev/ ---
BLOB_READ_WRITE_TOKEN=

# --- Resend (lib/email.ts) — transactional only: password reset, report received, account deleted ---
RESEND_API_KEY=
RESEND_FROM="Crew <crew@yourdomain.example>"
MODERATION_INBOX=you@yourdomain.example

# --- APNs (lib/push.ts) — HTTP/2 token auth; key is the .p8 contents with \n for newlines ---
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.yourteam.crew
APNS_ENVIRONMENT=sandbox

# --- Vercel Cron (api/cron/notifications, every minute per vercel.json) — Vercel sends this as a Bearer token ---
CRON_SECRET=change-me-to-a-long-random-string

# --- App (invite links, emails, cookies) ---
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
